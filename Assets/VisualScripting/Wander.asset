2","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"95"},"sourceKey":"value","destinationUnit":{"$ref":"108"},"destinationKey":"input","guid":"878db704-26c5-47d1-b43e-a91a27bf91f4","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"92"},"sourceKey":"value","destinationUnit":{"$ref":"88"},"destinationKey":"%a","guid":"5cb91a4a-5afd-46c0-aeb3-974420e02065","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"85"},"sourceKey":"value","destinationUnit":{"$ref":"83"},"destinationKey":"a","guid":"352727b3-4043-44e6-b15f-f3f84360da5b","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"83"},"sourceKey":"comparison","destinationUnit":{"$ref":"81"},"destinationKey":"condition","guid":"ac72ec64-7f53-473a-80b9-a530c3cb0544","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"88"},"sourceKey":"result","destinationUnit":{"$ref":"77"},"destinationKey":"%forward","guid":"82013f3c-b9d2-40cd-8799-812435e16129","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"97"},"sourceKey":"value","destinationUnit":{"$ref":"102"},"destinationKey":"a","guid":"fa310711-77a8-4889-bf9b-c9e8dedec108","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"114"},"sourceKey":"value","destinationUnit":{"$ref":"147"},"destinationKey":"%d","guid":"448fd8ca-8bd5-4487-9281-2815e3af1a58","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"111"},"sourceKey":"value","destinationUnit":{"$ref":"104"},"destinationKey":"%from","guid":"4ab6a217-b305-438c-8765-77b7b25389d8","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"77"},"sourceKey":"result","destinationUnit":{"$ref":"104"},"destinationKey":"%to","guid":"ede64f67-eaf1-4f4a-a7fa-c00c9db37a62","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"102"},"sourceKey":"product","destinationUnit":{"$ref":"104"},"destinationKey":"%maxDegreesDelta","guid":"defe2252-5cda-4a57-8d6a-e7a69d28ac3d","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"137"},"sourceKey":"value","destinationUnit":{"$ref":"147"},"destinationKey":"%a","guid":"69ec3747-2d18-4174-ba83-bc58170eb2a0","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"39"},"sourceKey":"value","destinationUnit":{"$ref":"158"},"destinationKey":"%targetPosition","guid":"ad0179a9-d776-4d8f-a210-405a5e8e058d","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"154"},"sourceKey":"result","destinationUnit":{"$ref":"158"},"destinationKey":"%path","guid":"70e3aec1-61f1-4f8c-90de-ddae66822294","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"158"},"sourceKey":"result","destinationUnit":{"$ref":"162"},"destinationKey":"condition","guid":"69a3fb0a-9f1b-463b-88f6-85e15dd7cdae","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"154"},"sourceKey":"result","destinationUnit":{"$ref":"164"},"destinationKey":"target","guid":"51ac64e8-bc7a-498a-8fd1-09cf15d1afda","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"164"},"sourceKey":"value","destinationUnit":{"$ref":"167"},"destinationKey":"a","guid":"bf93a367-b274-4dfb-ab3e-fcd79fad6556","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"169"},"sourceKey":"output","destinationUnit":{"$ref":"167"},"destinationKey":"b","guid":"4be92e77-6d8a-4011-b32f-78fbc607e0d7","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"167"},"sourceKey":"equal","destinationUnit":{"$ref":"171"},"destinationKey":"condition","guid":"88169dfe-4abd-4b61-b2c8-8e2e2a227cef","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"154"},"sourceKey":"result","destinationUnit":{"$ref":"173"},"destinationKey":"%path","guid":"3c108821-3a37-408c-9f2c-64678512e5ff","$type":"Unity.VisualScripting.ValueConnection"},{"position":{"xMin":-1270.0,"yMin":-1780.0,"xMax":-770.0,"yMax":-1490.0},"title":"7
      \u00b7 Orientarse seg\u00fan el movimiento real","body":"\n\nLee velocity del
      NavMeshAgent y elimina Y. sqrMagnitude > 0,01 evita calcular una rotaci\u00f3n
      con un vector casi nulo. LookRotation obtiene la orientaci\u00f3n hacia la
      marcha real, que puede diferir de la direcci\u00f3n del destino durante un
      giro.","colorTheme":"Purple","guid":"e10813c2-ce67-4613-93f0-79dcf5f874ee","$type":"Unity.VisualScripting.StickyNote"},{"position":{"xMin":650.0,"yMin":-2350.0,"xMax":1190.0,"yMax":-2050.0},"title":"8
      \u00b7 Girar de forma gradual","body":"\n\nRotateTowards acerca la rotaci\u00f3n
      actual a LookRotation. El l\u00edmite de cada frame es TurnSpeed \u00d7 deltaTime,
      en grados. Despu\u00e9s asigna el resultado a Transform.rotation. deltaTime
      mantiene una velocidad de giro comparable con distintos FPS. Baja TurnSpeed
      para girar m\u00e1s despacio.","colorTheme":"Purple","guid":"440233ac-d6e3-49c9-a674-1c9cbeaf937d","$type":"Unity.VisualScripting.StickyNote"},{"position":{"xMin":-1700.0,"yMin":-1200.0,"xMax":-1180.0,"yMax":-940.0},"title":"1
      \u00b7 Preparar el agente","body":"\r\n\r\nOn Enable activa autoBraking para
      reducir suavemente la velocidad al acercarse al destino. stoppingDistance queda
      en 0 y updateRotation est\u00e1 desactivado porque el grafo controla el giro.
      Acceleration = 4 suaviza las variaciones de velocidad.","colorTheme":"Blue","guid":"ce26fd99-a906-4a98-b795-5f43e3faa43e","$type":"Unity.VisualScripting.StickyNote"},{"position":{"xMin":-1800.0,"yMin":-400.0,"xMax":-1320.0,"yMax":-110.0},"title":"2
      \u00b7 Comprobar antes de mover","body":"\n\nUpdate revisa cada frame si el
      NavMeshAgent est\u00e1 activo y sobre el NavMesh. Solo entonces contin\u00faa.
      Mientras pathPending sea true espera a que termine el c\u00e1lculo de la ruta.
      As\u00ed evita pedir destinos sobre un agente que todav\u00eda no puede navegar.","colorTheme":"Orange","guid":"d98882c2-cba6-4397-a38f-29a20dcc7b2e","$type":"Unity.VisualScripting.StickyNote"},{"position":{"xMin":-1020.0,"yMin":60.0,"xMax":-520.0,"yMax":370.0},"title":"3
      \u00b7 Anticipar el siguiente destino","body":"\n\nBusca el siguiente destino
      al quedar 1,25 unidades para llegar. autoBraking permite una desaceleraci\u00f3n
      ligera, pero el cambio de ruta ocurre antes de detenerse. NextPointDistance
      regula ese margen: s\u00fabelo para anticipar m\u00e1s el cambio y reducir
      el frenado.","colorTheme":"Orange","guid":"c14cd8b0-23f4-4d40-b8a8-dd62652d6811","$type":"Unity.VisualScripting.StickyNote"},{"position":{"xMin":0.0,"yMin":1500.0,"xMax":520.0,"yMax":1780.0},"title":"4
      \u00b7 Generar una direcci\u00f3n aleatoria","body":"\n\nRandom.insideUnitSphere
      produce un vector aleatorio. Vector3.Scale elimina su componente Y para moverse
      en el plano XZ. Tras a\u00f1adir la preferencia hacia delante, normalized convierte
      la direcci\u00f3n en un vector de longitud 1. WanderRadius determina la longitud
      del siguiente paso.","colorTheme":"Green","guid":"326527d3-83f7-427d-a133-68592ff8dd08","$type":"Unity.VisualScripting.StickyNote"},{"position":{"xMin":600.0,"yMin":1350.0,"xMax":1120.0,"yMax":1630.0},"title":"5
      \u00b7 Favorecer la marcha hacia delante","body":"\n\nforward \u00d7 ForwardBias
      se suma a la direcci\u00f3n aleatoria. Con 0,35 hay m\u00e1s tendencia a continuar
      hacia delante y menos cambios bruscos. Mant\u00e9n ForwardBias por debajo de
      1 para conservar la posibilidad de elegir destinos hacia atr\u00e1s, por ejemplo
      cerca de bordes.","colorTheme":"Green","guid":"dda8dc87-615d-4920-94af-e2ca1bd46d13","$type":"Unity.VisualScripting.StickyNote"},{"position":{"xMin":1300.0,"yMin":420.0,"xMax":1840.0,"yMax":730.0},"title":"6
      \u00b7 Elegir un destino sobre el NavMesh","body":"\n\nSamplePosition busca
      un punto del NavMesh. CalculatePath calcula la ruta inmediatamente y exige
      PathComplete. SetPath aplica la ruta ya calculada en el mismo frame. La ruta
      anterior permanece activa si falla la b\u00fasqueda. No usa ResetPath ni espera
      al final del recorrido para empezar a calcular la siguiente ruta.","colorTheme":"Green","guid":"772fabae-7efd-4cc5-bf7d-32cc5a640d20","$type":"Unity.VisualScripting.StickyNote"},{"position":{"xMin":-1800.0,"yMin":80.0,"xMax":-1300.0,"yMax":420.0},"title":"Configuraci\u00f3n
      de Wander","body":"\r\n\r\nNecesita NavMeshAgent y NavMesh horneado. Asigna
      este asset a un Script Machine. Graph Variables: WanderRadius = 10; SampleDistance
      = 2; NextPointDistance = 1,25; TurnSpeed = 120; Acceleration = 4; ForwardBias
      = 0,35. autoBraking est\u00e1 activado. El radio parte de la posici\u00f3n
      actual.","colorTheme":"Blue","guid":"ae46c213-882d-47f6-b7f2-31990fe634d5","$type":"Unity.VisualScripting.StickyNote"}],"$version":"A"}}'
    _objectReferences: []
