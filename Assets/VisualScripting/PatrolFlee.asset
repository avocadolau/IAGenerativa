it":{"$ref":"141"},"destinationKey":"input","guid":"0e743a8f-5465-460c-a6aa-907ea70f11f7","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"121"},"sourceKey":"output","destinationUnit":{"$ref":"145"},"destinationKey":"fallback","guid":"730fb81d-e8e5-4e63-84ea-8c6c24dd65d6","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"220"},"sourceKey":"output","destinationUnit":{"$ref":"150"},"destinationKey":"fallback","guid":"817cc1d6-9b64-47a6-8a39-44bb25598e62","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"105"},"sourceKey":"equal","destinationUnit":{"$ref":"25"},"destinationKey":"condition","guid":"0cdf5945-8134-4a6e-879e-796ac0648d1a","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"66"},"sourceKey":"value","destinationUnit":{"$ref":"125"},"destinationKey":"target","guid":"e37f65c0-c47f-4373-979a-6accda9a65b4","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"81"},"sourceKey":"output","destinationUnit":{"$ref":"105"},"destinationKey":"b","guid":"093dcbf7-a961-40ee-bd81-bfa9ca97038f","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"20"},"sourceKey":"sum","destinationUnit":{"$ref":"97"},"destinationKey":"input","guid":"6a0c2227-a9b7-466d-99ca-d48104c3f30f","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"64"},"sourceKey":"output","destinationUnit":{"$ref":"83"},"destinationKey":"input","guid":"4fc83904-fbee-40af-bd60-12011a708552","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"46"},"sourceKey":"output","destinationUnit":{"$ref":"85"},"destinationKey":"input","guid":"fa7faf39-c6b5-4671-88bb-24fcf7a1482f","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"116"},"sourceKey":"value","destinationUnit":{"$ref":"156"},"destinationKey":"condition","guid":"014cdf60-c4bc-40b3-8759-04b18d20cd07","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"62"},"sourceKey":"value","destinationUnit":{"$ref":"89"},"destinationKey":"%path","guid":"eef96a58-1aee-4b64-9475-2ecbe57a1999","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"42"},"sourceKey":"result","destinationUnit":{"$ref":"69"},"destinationKey":"condition","guid":"78700197-1a84-4e42-91b8-52c322b004ef","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"38"},"sourceKey":"equal","destinationUnit":{"$ref":"93"},"destinationKey":"condition","guid":"594c3b9a-701d-4408-a7fb-24d7fc5583bd","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"56"},"sourceKey":"result","destinationUnit":{"$ref":"60"},"destinationKey":"input","guid":"a21c2b20-df19-4894-af5c-b277251a2a59","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"136"},"sourceKey":"value","destinationUnit":{"$ref":"42"},"destinationKey":"%targetPosition","guid":"3bcfa451-a145-4ac1-b8f3-b9e4f37d8f93","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"62"},"sourceKey":"value","destinationUnit":{"$ref":"42"},"destinationKey":"%path","guid":"5a97b044-f94e-4153-9812-04d6f0fc8a50","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"50"},"sourceKey":"value","destinationUnit":{"$ref":"52"},"destinationKey":"condition","guid":"43caa2ae-9f5e-40c9-8c1c-f99f707f6fdd","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"62"},"sourceKey":"value","destinationUnit":{"$ref":"32"},"destinationKey":"target","guid":"79ea3542-dce1-4f73-87b6-a5925912e6c1","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"95"},"sourceKey":"output","destinationUnit":{"$ref":"38"},"destinationKey":"b","guid":"1acfa88c-02b3-4ce7-9fea-54a5bf938c3f","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"185"},"sourceKey":"value","destinationUnit":{"$ref":"129"},"destinationKey":"a","guid":"44a7075a-de03-4ca5-be12-be247fb4667f","$type":"Unity.VisualScripting.ValueConnection"},{"position":{"xMin":-550.0,"yMin":1900.0,"xMax":-80.0,"yMax":2200.0},"title":"6
      \u00b7 Enviar el destino al agente","body":"\r\n\r\nSamplePosition ajusta el
      punto al NavMesh con SampleDistance y areaMask. CalculatePath comprueba que
      exista una ruta completa para este tipo de agente y SetPath la aplica. Si falla,
      se solicita otro punto mediante la recuperaci\u00f3n. Coloca los puntos en
      zonas conectadas del NavMesh.","colorTheme":"Green","guid":"b6195a41-5b70-4e7e-b172-8951543a3e86","$type":"Unity.VisualScripting.StickyNote"},{"position":{"xMin":-550.0,"yMin":760.0,"xMax":-80.0,"yMax":1060.0},"title":"3
      \u00b7 Leer la ruta de patrulla","body":"\n\nAl entrar desde Flee, NeedsPatrolPath
      = true obliga a buscar un destino de patrulla. La ruta anterior se conserva
      hasta tener una ruta nueva completa; ya no se llama a ResetPath. Update comprueba
      el agente y PatrolRoute debe existir y tener hijos.","colorTheme":"Orange","guid":"e3fb99cc-563a-4b7f-8c12-e0b3d58d1922","$type":"Unity.VisualScripting.StickyNote"},{"position":{"xMin":-550.0,"yMin":380.0,"xMax":-80.0,"yMax":680.0},"title":"2
      \u00b7 Preparar giro y navegaci\u00f3n","body":"\n\nAplica TurnSpeed y Acceleration.
      Comprueba isActiveAndEnabled e isOnNavMesh antes de continuar. isStopped =
      false reanuda el movimiento si estaba detenido. Esta configuraci\u00f3n se
      vuelve a aplicar al regresar desde Flee.","colorTheme":"Blue","guid":"eed3d6d4-7c29-4b19-b8e6-d511a6651f0e","$type":"Unity.VisualScripting.StickyNote"},{"position":{"xMin":-550.0,"yMin":0.0,"xMax":-80.0,"yMax":300.0},"title":"1
      \u00b7 Entrar en Patrolling","body":"\n\nOn Enter State escribe CurrentState
      = Patrolling y aplica PatrolSpeed (2,5 si no existe). Desactiva el frenado
      de llegada y activa la rotaci\u00f3n del NavMeshAgent. Los Literal conectados
      a fallback son valores por defecto: se usan si no has creado la variable de
      objeto.","colorTheme":"Blue","guid":"ea8d7b8a-0b06-4d12-82bf-5cfcf5552de0","$type":"Unity.VisualScripting.StickyNote"},{"position":{"xMin":-550.0,"yMin":1520.0,"xMax":-80.0,"yMax":1820.0},"title":"5
      \u00b7 Seleccionar el siguiente punto","body":"\n\nAl llegar, suma 1 a PatrolIndex
      y guarda el \u00edndice en Graph Variables. El m\u00f3dulo por childCount permite
      volver al primer punto tras el \u00faltimo. GetChild usa ese \u00edndice y
      obtiene su posici\u00f3n. PatrolIndex se conserva mientras este State Machine
      siga instanciado, incluso al pasar por Flee.","colorTheme":"Green","guid":"21bc8256-0e72-4ba8-ae7c-411b983cbc8d","$type":"Unity.VisualScripting.StickyNote"},{"position":{"xMin":-550.0,"yMin":1140.0,"xMax":-80.0,"yMax":1440.0},"title":"4
      \u00b7 Decidir cu\u00e1ndo avanzar","body":"\n\nchildCount debe ser mayor que
      0. Mientras pathPending sea true no se solicita otra ruta. Sin ruta, busca
      el punto actual. Con ruta, espera a que remainingDistance sea menor o igual
      que WaypointDistance (1 por defecto) para anticipar el siguiente punto.","colorTheme":"Orange","guid":"fb6c7bc8-6e1b-4bae-8827-cfb6bdec2ba2","$type":"Unity.VisualScripting.StickyNote"},{"position":{"xMin":-550.0,"yMin":2600.0,"xMax":-80.0,"yMax":2910.0},"title":"7
      \u00b7 Recuperar la patrulla","body":"\n\nNeedsPatrolPath fuerza una nueva
      ruta al entrar. CalculatePath usa el tipo del propio NavMeshAgent y exige PathComplete.
      Solo despu\u00e9s SetPath sustituye la ruta anterior y se desactiva la petici\u00f3n.
      As\u00ed el retorno no depende de haber terminado la huida.","colorTheme":"Green","guid":"32f646ee-9cac-461c-87d2-2267ced39f57","$type":"Unity.VisualScripting.StickyNote"},{"position":{"xMin":-550.0,"yMin":2980.0,"xMax":-80.0,"yMax":3290.0},"title":"8
      \u00b7 Recuperarse de puntos inv\u00e1lidos","body":"\n\nSi SamplePosition,
      CalculatePath o SetPath fallan, se mantiene NeedsPatrolPath y se avanza al
      siguiente punto. Cooldown limita estos reintentos a uno cada 0,25 segundos.
      Una ruta parcial o inv\u00e1lida tambi\u00e9n activa la recuperaci\u00f3n.
      Los puntos deben estar en zonas conectadas del NavMesh.","colorTheme":"Orange","guid":"13f76da3-3b23-4757-8d0f-a8104d9d5afc","$type":"Unity.VisualScripting.StickyNote"},{"position":{"xMin":-550.0,"yMin":4500.0,"xMax":-80.0,"yMax":4820.0},"title":"9
      \u00b7 Distancia desconocida","body":"\n\nUnity puede devolver remainingDistance
      = Infinity o NaN, incluso con una ruta completa. Se guarda PatrolDestination
      al aceptar una ruta. Si la distancia de ruta es desconocida, se usa la distancia
      directa a ese destino para detectar la llegada; en los dem\u00e1s casos se
      conserva remainingDistance.","colorTheme":"Orange","guid":"93bb1533-ac17-4d29-8be7-c6dcabe234c9","$type":"Unity.VisualScripting.StickyNote"}],"$version":"A"}},"isStart":true,"position":{"x":-350.0,"y":0.0},"width":230.0,"guid":"373bcbf5-83ed-4276-864e-6a20ba89eaf8","$version":"A","$type":"Unity.VisualScripting.FlowState","$id":"3"},{"nest":{"source":"Embed","macro":null,"embed":{"variables":{"Kind":"Flow","collection":{"$content":[{"name":"EscapeAttempt","value":{"$content":0.0,"$type":"System.Single"},"typeHandle":{"Identification":null,"$version":"A"},"$version":"A"}],"$version":"A"},"$version":"A"},"controlInputDefinitions":[],"controlOutputDefinitions":[],"valueInputDefinitions":[],"valueOutputDefinitions":[],"title":"Flee","summary":"Huye
      en direccion opuesta a Threat. Recalcula cada RepathInterval; solo acepta puntos
