position":{"x":1280.0,"y":380.0},"guid":"5ba13668-fb3f-496b-ba40-865172f00830","$version":"A","$type":"Unity.VisualScripting.ScalarSum","$id":"891"},{"specifyFallback":true,"kind":"Object","defaultValues":{"name":{"$content":"DetectDistance","$type":"System.String"},"object":null},"position":{"x":640.0,"y":380.0},"guid":"d094b225-2a08-482d-82ca-cc7e3c92a71d","$version":"A","$type":"Unity.VisualScripting.GetVariable","$id":"893"},{"type":"System.Single","value":{"$content":6.0,"$type":"System.Single"},"defaultValues":{},"position":{"x":960.0,"y":380.0},"guid":"b8004502-4606-4d80-9ffd-e3205dab7afd","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"895"},{"defaultValues":{"b":{"$content":1.0,"$type":"System.Single"}},"position":{"x":2560.0,"y":380.0},"guid":"8d772a8a-1e07-4550-a6ba-080bec1c4f24","$version":"A","$type":"Unity.VisualScripting.ScalarMultiply","$id":"897"},{"defaultValues":{},"position":{"x":0.0,"y":760.0},"guid":"c3f14b40-f01e-4138-ac77-ad655a213f8f","$version":"A","$type":"Unity.VisualScripting.If","$id":"899"},{"numeric":true,"defaultValues":{"b":{"$content":0.0,"$type":"System.Single"}},"position":{"x":2880.0,"y":380.0},"guid":"ef656590-bb64-44b0-b6e1-1c2a8d226a84","$version":"A","$type":"Unity.VisualScripting.GreaterOrEqual","$id":"901"},{"chainable":false,"parameterNames":["a","b"],"member":{"name":"Max","parameterTypes":["System.Single","System.Single"],"targetType":"UnityEngine.Mathf","targetTypeName":"UnityEngine.Mathf","$version":"A"},"defaultValues":{"%a":{"$content":0.0,"$type":"System.Single"},"%b":{"$content":0.0,"$type":"System.Single"}},"position":{"x":1600.0,"y":380.0},"guid":"1ba20e18-ef3a-4ea1-9b23-23f55ba04682","$version":"A","$type":"Unity.VisualScripting.InvokeMember","$id":"903"},{"type":"System.Single","value":{"$content":10.0,"$type":"System.Single"},"defaultValues":{},"position":{"x":2240.0,"y":380.0},"guid":"793e6827-77be-49dd-b5eb-7bc45ca27c44","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"907"},{"specifyFallback":true,"kind":"Object","defaultValues":{"name":{"$content":"SafeDistance","$type":"System.String"},"object":null},"position":{"x":1920.0,"y":380.0},"guid":"f7f7b3e4-b1ad-437c-b784-17add5a48771","$version":"A","$type":"Unity.VisualScripting.GetVariable","$id":"909"},{"sourceUnit":{"$ref":"899"},"sourceKey":"ifTrue","destinationUnit":{"$ref":"862"},"destinationKey":"trigger","guid":"531430b5-aec9-453b-895f-c51899fc8964","$type":"Unity.VisualScripting.ControlConnection"},{"sourceUnit":{"$ref":"885"},"sourceKey":"ifNull","destinationUnit":{"$ref":"862"},"destinationKey":"trigger","guid":"4dd9baee-cd23-4717-b1e5-283579e91481","$type":"Unity.VisualScripting.ControlConnection"},{"sourceUnit":{"$ref":"857"},"sourceKey":"trigger","destinationUnit":{"$ref":"885"},"destinationKey":"enter","guid":"0bfb6ded-19a2-4e20-a2e6-1da26bc107e7","$type":"Unity.VisualScripting.ControlConnection"},{"sourceUnit":{"$ref":"885"},"sourceKey":"ifNotNull","destinationUnit":{"$ref":"899"},"destinationKey":"enter","guid":"d409e9a0-a8fb-48b2-98b7-02b724f2a96a","$type":"Unity.VisualScripting.ControlConnection"},{"sourceUnit":{"$ref":"891"},"sourceKey":"sum","destinationUnit":{"$ref":"903"},"destinationKey":"%b","guid":"9f229611-8c37-4ff8-b1ac-f38160fad1bb","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"870"},"sourceKey":"value","destinationUnit":{"$ref":"885"},"destinationKey":"input","guid":"e392ae5d-1528-4b88-8a67-820f91bf5154","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"897"},"sourceKey":"product","destinationUnit":{"$ref":"901"},"destinationKey":"b","guid":"1865e5d1-1c96-4abe-b7f7-1e16974ccc69","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"859"},"sourceKey":"value","destinationUnit":{"$ref":"864"},"destinationKey":"target","guid":"ffbbf787-58bd-4551-9a50-9c37f4a9cd86","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"872"},"sourceKey":"null","destinationUnit":{"$ref":"870"},"destinationKey":"fallback","guid":"b21b7707-bf23-476e-95cd-70f3571b91cd","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"909"},"sourceKey":"value","destinationUnit":{"$ref":"903"},"destinationKey":"%a","guid":"f1c66f76-3e96-450a-a626-e5637403c2d1","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"887"},"sourceKey":"result","destinationUnit":{"$ref":"891"},"destinationKey":"0","guid":"b32b3a4e-a224-4c37-a284-7f3b97c79935","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"895"},"sourceKey":"output","destinationUnit":{"$ref":"893"},"destinationKey":"fallback","guid":"2733dfd3-36ec-4998-a275-15ba351e4133","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"907"},"sourceKey":"output","destinationUnit":{"$ref":"909"},"destinationKey":"fallback","guid":"2aeecc4a-719f-4a18-b585-f0154c1f4736","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"903"},"sourceKey":"result","destinationUnit":{"$ref":"897"},"destinationKey":"a","guid":"51280d61-b303-46d0-9c5d-f3702ed395b3","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"877"},"sourceKey":"result","destinationUnit":{"$ref":"881"},"destinationKey":"%a","guid":"eec937ee-e68a-4bc8-89b8-6aad149fad9f","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"867"},"sourceKey":"value","destinationUnit":{"$ref":"901"},"destinationKey":"a","guid":"7f56460f-4a78-4663-8a12-7bcd64ace221","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"864"},"sourceKey":"value","destinationUnit":{"$ref":"877"},"destinationKey":"%b","guid":"b358171a-c57a-4fff-89dd-18b1316c8989","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"903"},"sourceKey":"result","destinationUnit":{"$ref":"897"},"destinationKey":"b","guid":"c12dc001-a97e-4d32-8f2e-12355937e262","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"901"},"sourceKey":"comparison","destinationUnit":{"$ref":"899"},"destinationKey":"condition","guid":"7e907700-af74-4d1b-8aaf-e64d9f09d2d6","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"881"},"sourceKey":"result","destinationUnit":{"$ref":"867"},"destinationKey":"target","guid":"49062175-aa3b-4f41-bd3b-ead1f613d18d","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"893"},"sourceKey":"value","destinationUnit":{"$ref":"887"},"destinationKey":"%a","guid":"c5e80132-a0d8-4f2a-abc3-339c59f3e453","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"874"},"sourceKey":"value","destinationUnit":{"$ref":"877"},"destinationKey":"%a","guid":"fe733459-8bb2-44d9-b9ee-9266089cb80d","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"870"},"sourceKey":"value","destinationUnit":{"$ref":"859"},"destinationKey":"target","guid":"953e9f59-c55f-49da-b701-3a3623316963","$type":"Unity.VisualScripting.ValueConnection"},{"position":{"xMin":-550.0,"yMin":0.0,"xMax":-80.0,"yMax":300.0},"title":"1
      \u00b7 Vigilar mientras huye","body":"\n\nEsta transici\u00f3n solo se escucha
      mientras Flee est\u00e1 activo. Si Threat desaparece o queda vac\u00edo, Trigger
      State Transition regresa directamente a Patrolling. Si sigue existiendo, calcula
      la separaci\u00f3n horizontal entre los dos objetos.","colorTheme":"Orange","guid":"f8c7d4a3-ecf4-4b22-b495-d5359ba24e83","$type":"Unity.VisualScripting.StickyNote"},{"position":{"xMin":-550.0,"yMin":380.0,"xMax":-80.0,"yMax":680.0},"title":"2
      \u00b7 Mantener una franja de seguridad","body":"\n\nEl l\u00edmite de salida
      es max(SafeDistance, DetectDistance + 1). Por defecto vale 10. Exigir m\u00e1s
      separaci\u00f3n para volver que para empezar a huir evita alternar continuamente
      entre estados. Compara la distancia al cuadrado con el l\u00edmite al cuadrado
      usando Greater Or Equal.","colorTheme":"Orange","guid":"49fa0d4f-9e2b-4bee-b281-91f9769ba3cf","$type":"Unity.VisualScripting.StickyNote"},{"position":{"xMin":-550.0,"yMin":760.0,"xMax":-80.0,"yMax":1060.0},"title":"3
      \u00b7 Volver a patrullar","body":"\n\nCuando la condici\u00f3n es verdadera,
      este If llama a Trigger State Transition. Flee deja de escuchar sus eventos
      y entra Patrolling, que recupera PatrolSpeed, descarta la ruta de huida y retoma
      su \u00edndice de patrulla. Si la distancia a\u00fan es insuficiente, contin\u00faa
      en Flee.","colorTheme":"Green","guid":"29b51b83-9576-45cb-972a-6c93e7dcc09a","$type":"Unity.VisualScripting.StickyNote"}],"$version":"A"}},"source":{"$ref":"342"},"destination":{"$ref":"3"},"guid":"08bf089a-382e-47cb-aff0-32dea7d701a6","$version":"A","$type":"Unity.VisualScripting.FlowStateTransition"},{"position":{"xMin":-600.0,"yMin":-400.0,"xMax":-120.0,"yMax":-120.0},"title":"M\u00e1quina
      de estados","body":"\n\nPatrolling es el estado inicial (barra verde). Cada
      estado tiene su propio Script Graph: \u00e1brelo con doble clic. Las dos flechas
      son transiciones y tambi\u00e9n contienen grafos. Solo permanece activo uno
      de los dos estados a la vez.","colorTheme":"Blue","guid":"b914f9bd-4a38-4d89-9b1f-01eda561dd62","$type":"Unity.VisualScripting.StickyNote"},{"position":{"xMin":0.0,"yMin":-400.0,"xMax":500.0,"yMax":-120.0},"title":"Cambios
      por proximidad","body":"\n\nPatrolling \u2192 Flee: Threat a 6 unidades o menos.
      Flee \u2192 Patrolling: Threat a 10 unidades o m\u00e1s, o la amenaza desaparece.
      Las distancias diferentes forman una franja de seguridad para evitar cambios
      constantes de estado en el l\u00edmite. La distancia se mide en XZ, sin comprobar
      visi\u00f3n.","colorTheme":"Orange","guid":"fcc524c6-5def-42b6-8517-ce0152fa24a6","$type":"Unity.VisualScripting.StickyNote"},{"position":{"xMin":-600.0,"yMin":280.0,"xMax":-100.0,"yMax":600.0},"title":"Referencias
      que debes asignar","body":"\n\nEn Object Variables del agente: Threat = objeto
      del que huir; PatrolRoute = padre fijo con los puntos de patrulla como hijos.
      No pongas la ruta dentro del agente. Necesita NavMeshAgent sobre un NavMesh
      y este asset en un State Machine. Desactiva otros grafos de movimiento en ese
      agente.","colorTheme":"Blue","guid":"f19b9682-c34a-4316-b927-ebdd82377842","$type":"Unity.VisualScripting.StickyNote"},{"position":{"xMin":0.0,"yMin":280.0,"xMax":500.0,"yMax":600.0},"title":"Qu\u00e9
      puedes ajustar","body":"\n\nLos par\u00e1metros opcionales son Object Variables
      de tipo Float. DetectDistance 6; SafeDistance 10; PatrolSpeed 2,5; FleeSpeed
      5; WaypointDistance 1; FleeDistance 8; RepathInterval 0,35; SampleDistance
      2; TurnSpeed 120; Acceleration 4. CurrentState muestra el estado activo durante
      Play.","colorTheme":"Blue","guid":"ed068dd3-802b-4336-9777-3fa81fb40da9","$type":"Unity.VisualScripting.StickyNote"}],"$version":"A"}}'
    _objectReferences: []
