  m_Name: AgenteFantasma
  m_EditorClassIdentifier: Unity.VisualScripting.Flow::Unity.VisualScripting.ScriptGraphAsset
  _data:
    _json: '{"graph":{"variables":{"Kind":"Flow","collection":{"$content":[],"$version":"A"},"$version":"A"},"controlInputDefinitions":[],"controlOutputDefinitions":[],"valueInputDefinitions":[],"valueOutputDefinitions":[],"title":null,"summary":null,"pan":{"x":0.0,"y":0.0},"zoom":1.0,"elements":[{"coroutine":false,"defaultValues":{},"position":{"x":-204.0,"y":-144.0},"guid":"070d955d-26d7-4a06-94e4-7775f9e46803","$version":"A","$type":"Unity.VisualScripting.Start"},{"coroutine":false,"defaultValues":{},"position":{"x":-204.0,"y":60.0},"guid":"f6e34caf-98dd-4802-a18e-cae4ddc201f3","$version":"A","$type":"Unity.VisualScripting.Update"},{"position":{"xMin":-350.0,"yMin":-480.0,"xMax":270.0,"yMax":-210.0},"title":"Este
      grafo todav\u00eda est\u00e1 vac\u00edo","body":"\n\nAgenteFantasma solo contiene
      Start y Update sin conexiones. Por s\u00ed solo no mueve al personaje ni ejecuta
      la m\u00e1quina de estados. El movimiento que hemos creado est\u00e1 en Wander.asset
      y en PatrolFlee.asset. Elige el asset correspondiente en el componente de la
      escena.","colorTheme":"Blue","guid":"3a0003c2-417d-4d1b-982a-7e49ec162b71","$type":"Unity.VisualScripting.StickyNote"},{"position":{"xMin":150.0,"yMin":-150.0,"xMax":610.0,"yMax":30.0},"title":"Start
      \u00b7 Una vez al comenzar","body":"\n\nEste evento se dispara al arrancar
      el objeto. Aqu\u00ed se conectar\u00edan los nodos de inicializaci\u00f3n.
      Al no tener ning\u00fan cable de salida, no ejecuta acciones adicionales.","colorTheme":"Classic","guid":"740b39b8-a6a5-418a-9914-0bfb6c179b39","$type":"Unity.VisualScripting.StickyNote"},{"position":{"xMin":150.0,"yMin":80.0,"xMax":610.0,"yMax":260.0},"title":"Update
      \u00b7 Una vez por frame","body":"\n\nEste evento sirve para l\u00f3gica que
      se comprueba continuamente durante Play. Aqu\u00ed no tiene conexiones, as\u00ed
      que no realiza ninguna acci\u00f3n.","colorTheme":"Classic","guid":"adf483fb-2d01-4c26-b3a6-b788beba60d3","$type":"Unity.VisualScripting.StickyNote"}],"$version":"A"}}'
    _objectReferences: []
